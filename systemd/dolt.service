[Unit]
Description=dolt SQL server (Git-style version-controlled database)
Documentation=https://docs.dolthub.com/introduction
# Pure network-listening daemon: hard-depend on the online network stack
# rather than merely wanting it, and order startup after it so listening
# sockets bind only once interfaces are up.
Requires=network-online.target
After=network-online.target
# Refuse to start until an administrator has installed a config. Copy
# /etc/dolt/server.yaml.example to /etc/dolt/server.yaml and edit it;
# until then `start` is a no-op (condition-not-met), not a failure.
ConditionPathExists=/etc/dolt/server.yaml

[Service]
Type=simple
User=_dolt
Group=_dolt

# --- Working layout -------------------------------------------------------
# /run/dolt and /var/lib/dolt are created and chowned by systemd via
# RuntimeDirectory=/StateDirectory=. /etc/dolt is provisioned separately
# by the packaged tmpfiles snippet (root:_dolt, 0750).
WorkingDirectory=/var/lib/dolt
Environment=DOLT_ROOT_PATH=/var/lib/dolt
RuntimeDirectory=dolt
StateDirectory=dolt

# --- Command --------------------------------------------------------------
ExecStart=/usr/bin/dolt sql-server --config /etc/dolt/server.yaml

# Graceful shutdown: dolt traps SIGTERM (via signal.NotifyContext);
# give it a generous deadline to flush chunks and drop listeners.
KillSignal=SIGTERM
TimeoutStopSec=60s

# Hardening — dolt needs neither elevated privileges nor broad FS access.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Config dir is read-only to the service; admins edit /etc/dolt out-of-band.
ReadWritePaths=/var/lib/dolt /run/dolt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Optional resource caps — uncomment to taste.
# MemoryMax=4G
# TasksMax=512

[Install]
# Standard non-graphical system boot target (runlevel 3). This is the
# conventional install hook for system daemons — including pure network
# services such as sshd / nginx / postgres — and is independent of user
# logins. The network dependency is expressed above via Requires=/After=,
# not via this target.
WantedBy=multi-user.target
