#!/usr/bin/make -f

LDFLAGS := -s -w
http_proxy=
https_proxy=

# debhelper's golang buildsystem leaks GO111MODULE=off et al. into every
# override target merely by being probed during buildsystem autodetection,
# which breaks this module-mode build (upstream go.mod lives in go/, not at
# the top level, so the golang buildsystem is never actually selected).
unexport GO111MODULE GOPATH GOPROXY GOTOOLCHAIN GOCACHE

%:
	dh $@

override_dh_auto_build:
	@true

# Hermetic GnuPG home for TestSignAndVerifyCommit, which imports a test key
# via `gpg --import`; without this it would touch the invoking user's
# ~/.gnupg (and fail if that holds a legacy secring.gpg it cannot migrate).
TEST_GNUPGHOME := $(CURDIR)/debian/gnupghome-test

override_dh_auto_test:
	install -d -m 700 $(TEST_GNUPGHOME)
	cd go && GNUPGHOME=$(TEST_GNUPGHOME) go test -vet=off -timeout 10m ./cmd/dolt/... ./utils/remotesrv/... ./store/cmd/noms/...
	rm -rf $(TEST_GNUPGHOME)

override_dh_auto_install:
	mkdir -p $(CURDIR)/debian/tmp/usr/bin
	cd go && CGO_ENABLED=1 go build -mod=readonly -ldflags "$(LDFLAGS)" -o $(CURDIR)/debian/tmp/usr/bin/dolt ./cmd/dolt/.
	cd go && CGO_ENABLED=1 go build -mod=readonly -ldflags "$(LDFLAGS)" -o $(CURDIR)/debian/tmp/usr/bin/remotesrv ./utils/remotesrv/.
	cd go && CGO_ENABLED=1 go build -mod=readonly -ldflags "$(LDFLAGS)" -o $(CURDIR)/debian/tmp/usr/bin/noms ./store/cmd/noms/.

	mkdir -p debian/tmp/usr/lib/systemd/system debian/tmp/etc \
		debian/tmp/usr/lib/sysusers.d debian/tmp/usr/lib/tmpfiles.d
	ln -s usr/lib debian/tmp/lib
	DESTDIR=$(CURDIR)/debian/tmp systemd/INSTALL.sh

override_dh_clean:
	dh_clean
	rm -rf $(CURDIR)/debian/tmp
